# Port number for the backend server
PORT=3000

# MongoDB Connection String (e.g., mongodb://localhost:27017/the-dark-store or MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017/the-dark-store

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# ImageKit Configuration (for image hosting & upload)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint_here

# Razorpay Configuration (for payment integration)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Environment Mode (development / production)
NODE_ENV=development
