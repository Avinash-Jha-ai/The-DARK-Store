# Base URL for Axios requests to backend API (e.g., http://localhost:3000 for local development)
# Leave blank to use relative paths (proxy configuration in vite.config.js will forward requests to backend)
VITE_API_URL=http://localhost:3000

# Razorpay Key ID (should match RAZORPAY_KEY_ID in backend)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
